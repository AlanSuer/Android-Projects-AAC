<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <ImageView android:id="@+id/ivCube1" android:layout_width="90dp" android:layout_height="90dp" android:src="@drawable/cubilete" />
        <ImageView android:id="@+id/ivCube2" android:layout_width="90dp" android:layout_height="90dp" android:src="@drawable/cubilete" />
        <ImageView android:id="@+id/ivCube3" android:layout_width="90dp" android:layout_height="90dp" android:src="@drawable/cubilete" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <ImageView android:id="@+id/ivCube4" android:layout_width="90dp" android:layout_height="90dp" android:src="@drawable/cubilete" />
        <ImageView android:id="@+id/ivCube5" android:layout_width="90dp" android:layout_height="90dp" android:src="@drawable/cubilete" />
        <ImageView android:id="@+id/ivCube6" android:layout_width="90dp" android:layout_height="90dp" android:src="@drawable/cubilete" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="35dp" />

    <Button
        android:id="@+id/bStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:text="Start"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text=""
        android:textAlignment="center"
        android:textSize="35sp" />
</LinearLayout>